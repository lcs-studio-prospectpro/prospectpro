{
  "name": "prospectpro-desktop",
  "version": "1.0.0",
  "description": "ProspectPro Desktop — single-license territory prospecting app",
  "main": "main.js",
  "author": "Lighting + Controls Solutions LLC",
  "license": "UNLICENSED",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder"
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.lcsstudio.prospectpro.desktop",
    "productName": "ProspectPro",
    "copyright": "Copyright © Lighting + Controls Solutions LLC",
    "directories": { "output": "dist" },
    "files": ["main.js", "preload.js", "icon.png"],
    "artifactName": "ProspectPro-Setup.${ext}",
    "win": { "target": "nsis", "icon": "icon.png" },
    "mac": { "target": "dmg", "icon": "icon.png", "category": "public.app-category.business" },
    "linux": { "target": "AppImage", "icon": "icon.png", "category": "Office" },
    "nsis": { "oneClick": false, "allowToChangeInstallationDirectory": true, "perMachine": false }
  }
}
